m_PluralItemName=""
m_Description="Esta é uma carta assinada do Lorde Regente concedendo a Timsh imunidade legal a todas as disposições da peste."

[Inventory.Odorous_Sack_Abst DisAbstractItem]
m_ItemName="Saco Fedorento"
