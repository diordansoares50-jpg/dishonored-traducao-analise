[DisDLC05GameInfo]
m_Challenges[0]=(m_Name="Mystery Foe",m_Description="Collect the four clues without being detected to discover who your target is and execute him or her.",m_ExpertModeDesc="Very Hard stealth difficulty. The clues are placed on the belts of some characters.")
m_Challenges[1]=(m_Name="Burglar",m_Description="Sneak into the mansion to recover the six Clockwork Eggs and as many valuables as you can, such as heirlooms, paintings, and coins.",m_ExpertModeDesc="Very Hard stealth difficulty. You have no supernatural powers. Some doors and chests are locked, and the placement of the valuables is different.")
m_Challenges[2]=(m_Name="Back Alley Brawl",m_Description="Fight your way through increasingly difficult waves of enemies.",m_ExpertModeDesc="Combat difficulty set to Very Hard. The enemies are aware of you as soon as they appear.")
m_Challenges[3]=(m_Name="Assassin’s Run",m_Description="Armed with just a crossbow, proceed through the level and shoot your targets as fast as possible while avoiding shooting civilians.",m_ExpertModeDesc="")
m_Challenges[4]=(m_Name="Oil Drop",m_Description="Shoot as many falling Whale Oil Tanks as possible.",m_ExpertModeDesc="")
m_Challenges[5]=(m_Name="Bend Time Massacre",m_Description="Break the glass to start Bend Time and kill as many enemies as possible. Between each successive round, a bonus challenge can be attempted.",m_ExpertModeDesc="")
m_Challenges[6]=(m_Name="Kill Chain",m_Description="Kill an increasingly high number of enemies in a continuous chain using the environments and/or your powers. Between each round, a bonus challenge can be attempted.",m_ExpertModeDesc="")
m_Challenges[7]=(m_Name="Bonfires",m_Description="Touch as many beams of red light as you can before the time runs out.",m_ExpertModeDesc="Assassins patrol the area. Grab the elixirs dispatched around the map to restore your mana.")
m_Challenges[8]=(m_Name="Train Runner",m_Description="Reach the goal as fast as possible.",m_ExpertModeDesc="Mana is limited. Some Assassins patrol the area. Some obstacles are added.")
m_Challenges[9]=(m_Name="Kill Cascade",m_Description="Perform Drop Assassinations as you try to reach the final platform as fast as possible.",m_ExpertModeDesc="Some obstacles are added between platforms. You take damage from falls.")

