[DisDLC05MoviePlayerChallengeMenu_Texts]
t_Gallery = "Gallery"
t_BackToMainMenu = "Back to Main Menu"
t_ExpertModeTitle = "Expert mode: "
t_ChallengeUnlockCondition = "To unlock this challenge, you have to obtain §C_WHITE§2 stars§C§ in Normal mode (§PTS_COUNT§)"
t_StartChallenge="Iniciar Desafio"
t_Credits="Créditos"
t_DLC05_Name="Provas da Cidade de Dunwall"
t_Q_DLC05_BackToMain="Sair de §C_BLUE§Desafios da Cidade de Dunwall§C§ para voltar ao menu principal?"
t_Welcome_txt0="Bem-vindo às Provas da Cidade de Dunwall!<br>Aqui você pode aprimorar suas habilidades de assassino sobrenatural em §C_WHITE§10 desafios diferentes§C§ e comparar seu desempenho com o de outros jogadores ao redor do mundo.<br>Há 4 tipos de desafios:"
t_Welcome_txt1="Sua pontuação é avaliada com uma classificação de 3 Estrelas. Para cada Estrela conquistada, você desbloqueia uma obra de arte na §C_WHITE§Galeria§C§."
t_Welcome_txt2="Conseguir uma classificação de §C_WHITE§2 Estrelas§C§ em alguns desafios desbloqueia uma versão §C_WHITE§Especialista§C§ desse desafio."
t_Welcome_txt3_Xenon="Seu progresso, pontuações e desbloqueios são salvos automaticamente nas suas configurações de usuário."
t_Welcome_txt3_PS3="Seu progresso, pontuações e desbloqueios são salvos automaticamente nas suas configurações de usuário."
t_Welcome_txt3_PC="Seu progresso, pontuações e desbloqueios são salvos automaticamente nas suas configurações de usuário."
t_ArtworkUnlockCondition_0="Desbloqueio: Obtenha §STARS§ estrela(s) (§PTS_COUNT§) em §CHALLENGE§ - §MODE§"
t_ArtworkUnlockCondition_0p="Desbloqueio: Obtenha §STARS§ estrelas (§PTS_COUNT§) em §CHALLENGE§ - §MODE§"
t_ArtworkUnlockCondition_1="Desbloqueio: Desbloqueie todas as obras de arte do modo §MODE§"
[DisDLC05MoviePlayerResultsMenu_Texts]
t_BestScore="Melhor pontuação no desafio"
t_FinalScore="Pontuação Final"
t_NewRecord="Novo Recorde!"
t_Found="Encontrado"
t_NotFound="Não encontrado"
t_EmilyDoll="A Boneca da Emily"
t_ReplayChallenge="Desafio de Replay"
t_UnlockedArtworkTitle="Obra de arte desbloqueada"
t_UnlockedArtworkTxt="Uma nova ilustração está disponível na galeria"
t_UnlockedChallengeTitle="Desafio desbloqueado"
t_UnlockedChallengeTxt="O desafio “§NAME§” (Especialista) já está disponível"

[DisDLC05MoviePlayerBrief_Texts]
t_Section_Ob="Objetivos"
t_Section_Sc="Pontuação"
t_Section_Sp="Especial"
t_Section_Go="Fim de jogo"
t_Type="Tipo:"


t_AssassinsTraining_N_Ob_d="Armado apenas com uma besta, avance pelo nível e atire em seus alvos o mais rápido possível, evitando os civis."
t_AssassinsTraining_N_Ob_0="Este desafio vai testar sua mobilidade e sua precisão. A área está cheia de inimigos. Cada sala fica trancada até que você acerte todos os alvos. Sua besta tem munição infinita."
t_AssassinsTraining_N_Sc_0="Quanto mais rápido você chegar ao fim, mais pontos você ganha."
t_AssassinsTraining_N_Sc_1="Atire nos inimigos com precisão e estilo para uma pontuação melhor."
t_AssassinsTraining_N_Sc_2="Poupar civis aumenta sua pontuação."
t_AssassinsTraining_N_Go_d="O desafio termina se você morrer."


t_BendTimeMassacre_N_Ob_d="Quebre o vidro para ativar o Tempo Distorcido (por alguns segundos) e mate o máximo de inimigos possível."
t_BendTimeMassacre_N_Ob_0="Você enfrentará uma sequência de rodadas com situações e recursos diferentes. Use o ambiente a seu favor. Você pode repetir uma rodada quantas vezes quiser, mas apenas a pontuação da primeira tentativa bem-sucedida será adicionada ao seu total."
t_BendTimeMassacre_N_Sc_0="Cada eliminação te dá pontos."
t_BendTimeMassacre_N_Sc_1="Matar inimigos com estilo te dá mais pontos."
t_BendTimeMassacre_N_Sc_2="Eliminar todos os inimigos em um round concede pontos bônus."
t_BendTimeMassacre_N_Sp_d="Cada vez que uma rodada é concluída, você tem uma única tentativa para jogar uma rodada bônus com um objetivo único, ganhando pontos extras se completá-la."
t_BendTimeMassacre_N_Go_d="Nenhum. Se você falhar em uma rodada ou morrer, basta reiniciá-la."


t_Arena_N_Ob_d="Lute seu caminho através de ondas de inimigos cada vez mais difíceis."
t_Arena_N_Sc_0="Cada inimigo que você elimina concede pontos."
t_Arena_N_Sc_1="Matar inimigos com estilo te dá mais pontos."
t_Arena_N_Sp_0="Um Mercador Dourado aparecerá por 30 segundos. Acerte-o para ganhar munição e elixires. Mate-o para obter melhorias de equipamento."
t_Arena_N_Sp_1="Runas aparecem aleatoriamente no ambiente entre algumas rodadas. Colete-as para obter um novo poder."
t_Arena_N_Sp_2="Há facções rivais, e elas vão lutar entre si. Você pode usar essa situação a seu favor, mas apenas suas próprias eliminações aumentarão sua pontuação."
t_Arena_N_Go_d="O desafio acaba se você morrer."
t_Arena_E_Ob_0="Os inimigos causam muito mais dano e sabem onde você está assim que aparecem."


t_ChainKill_N_Ob_d="Elimine um número crescente de inimigos com menos de 4 segundos entre cada abate."
t_ChainKill_N_Ob_0="A contagem regressiva entre cada abate só começa após o primeiro ataque."
t_ChainKill_N_Ob_1="Leve o tempo necessário para planejar sua sequência de ações. Experimente seus poderes sobrenaturais e gadgets. A habilidade Dobrar o Tempo é sua maior aliada. Também é possível usar o ambiente de forma criativa."
t_ChainKill_N_Sc_0="Cada eliminação te dá pontos."
t_ChainKill_N_Sc_1="Quanto menor o tempo entre as mortes, mais pontos você ganha."
t_ChainKill_N_Sc_2="Matar inimigos com estilo te dá mais pontos."
t_ChainKill_N_Sp_d="Cada vez que uma rodada é concluída, você tem uma única tentativa para jogar uma rodada bônus com um objetivo único, ganhando pontos extras se completá-la."
t_ChainKill_N_Go_d="Nenhuma. Se você falhar em uma rodada, basta reiniciá-la."


t_Countdown_N_Ob_d="Toque no maior número de feixes de luz vermelha possível antes que o tempo acabe."
t_Countdown_N_Ob_0="Toque nos feixes de luz vermelhos que aparecem aleatoriamente.<br>Cada feixe de luz que você alcançar estenderá a contagem regressiva.<br>Poderes de mobilidade como `GBA_Blink` e `GBA_Agility` são as melhores ferramentas para este desafio.<br>Se você cair no Vazio, reiniciará no último feixe que alcançou."
t_Countdown_N_Ob_1="Não há dano de queda.<br>Sua mana recarrega muito rapidamente, então não hesite em usar Piscar com frequência."
t_Countdown_N_Sc_0="Cada feixe vermelho alcançado aumenta sua pontuação, incluindo um bônus por alcançar o próximo rapidamente."
t_Countdown_N_Sc_1="Alguns saltos difíceis concedem um bônus de pontuação quando executados."
t_Countdown_N_Go_d="O desafio termina quando o cronômetro chegar a 0."
t_Countdown_E_Ob_1="Assassinos patrulham a área.<br>Sua mana se regenerará lentamente.<br>Pegue os elixires de mana pela área para restaurá-la mais rápido."
t_Countdown_E_Sc_2="Sua saúde restante ao final do desafio concede um bônus de pontuação."
t_Countdown_E_Go_d="O jogo termina quando o cronômetro chega a 0 ou se você morrer."


t_DropAttack_N_Ob_d="Execute Assassinatos em Queda enquanto tenta alcançar a plataforma final o mais rápido possível."
t_DropAttack_N_Ob_0="Inimigos são marcados por um feixe de luz.<br>Para conseguir recompensas melhores ou avançar mais rápido, você pode sair do caminho marcado.<br>Se cair no Vazio, você reinicia na plataforma do último inimigo que derrotou."
t_DropAttack_N_Ob_1="Você não sofre dano ao cair."
t_DropAttack_N_Sc_0="Quanto maior a queda antes de um assassinato em queda, mais pontos você marca."
t_DropAttack_N_Sc_1="Quanto mais rápido você chegar ao fim, maior será sua pontuação."
t_DropAttack_N_Sp_d="Se você seguir o caminho, pode usar a cor dos feixes de luz como pista:"
t_DropAttack_N_Sp_0="VERDE: Corra e caia para alcançar o alvo (Sem Pular, Sem Piscar)."
t_DropAttack_N_Sp_1="AMARELO: Corra e faça um Salto de Agilidade para alcançar o alvo (Sem Piscar)."
t_DropAttack_N_Sp_2="VERMELHO: Corra, faça um Salto de Agilidade e Pisque para alcançar o alvo."
t_DropAttack_N_Go_d="Nenhum."
t_DropAttack_E_Ob_1="Você realmente sofre dano ao cair, então realizar Assassinatos de Queda bem-sucedidos é sua melhor chance de sobrevivência.<br>A área tem obstáculos adicionais."
t_DropAttack_E_Go_d="O desafio acaba se você morrer."

 
t_MysteryMan_N_Ob_d="Colete as quatro pistas sem ser detectado para descobrir quem é seu alvo e executá-lo."
t_MysteryMan_N_Ob_0="O alvo é escolhido aleatoriamente cada vez que você joga.<br>Você pode tentar descobrir quem é seu alvo sem todas as pistas, mas se matar um inocente, o desafio acaba.<br>NÃO seja visto, caso contrário seu alvo tentará fugir. Se ele ou ela escapar, o desafio acaba."
t_MysteryMan_N_Sc_0="Se você eliminar a pessoa certa sem coletar todas as pistas, receberá um bônus de pontuação."
t_MysteryMan_N_Sc_1="Evitar os guardas completamente vale mais pontos do que deixá-los inconscientes."
t_MysteryMan_N_Go_d="O desafio acaba se o alvo escapar ou se você matar uma pessoa inocente."
t_MysteryMan_E_Ob_1="As pistas estão nos cintos de alguns personagens. Você terá que roubá-los. Os inimigos têm uma percepção mais aguçada."


t_OilRain_N_Ob_d="Atire no máximo possível de Tanques de Óleo de Baleia que estão caindo.<br>Você tem uma pistola totalmente melhorada com munição infinita. Cada rodada termina com uma "Rodada Especial" mais desafiadora, sinalizada por um som de trombeta."
t_OilRain_N_Sc_0="Cada tanque destruído te dá pontos."
t_OilRain_N_Sc_1="Você ganha um bônus de pontuação se destruir vários tanques ao mesmo tempo."
t_OilRain_N_Sc_2="Você ganha um bônus de pontuação se não errar nenhum tanque durante uma rodada."
t_OilRain_N_Sc_3="Você ganha um bônus de pontuação por boa precisão."
t_OilRain_N_Sp_d="Existem vários tipos de Tanques de Óleo de Baleia:"
t_OilRain_N_Sp_0="Tanque Comum: serve apenas para pontos"
t_OilRain_N_Sp_1="Tanque de Ouro: desacelera o tempo por 2 segundos"
t_OilRain_N_Sp_2="Tanque Rosa: restaura 35% da sua saúde"
t_OilRain_N_Sp_3="Tanque Roxo: cria uma nuvem de fumaça ao ser atingido"
t_OilRain_N_Sp_4="Tanque Verde: ativa a Visão Noturna por 15 segundos"
t_OilRain_N_Go_d="O desafio acaba se você morrer."


t_Race_N_Ob_d="Alcance a linha de chegada o mais rápido possível.<br>Poderes de mobilidade como `GBA_Blink` e `GBA_Agility` são as melhores ferramentas para este desafio."
t_Race_N_Ob_0="Você começa com a barra de Mana cheia."
t_Race_N_Sc_0="Quanto mais rápido você chegar ao fim, maior será sua pontuação."
t_Race_N_Sc_1="Sua saúde e mana restantes ao final do desafio concedem pontos bônus."
t_Race_N_Go_d="O desafio acaba se você morrer ou cair no Vazio."
t_Race_E_Ob_0="Você não começa com a barra de Mana cheia, e Assassinos patrulham a área. A área tem obstáculos adicionais."


t_Thief_N_Ob_d="Roube os seis Ovos Mecânicos e saia da mansão."
t_Thief_N_Ob_0="Invada na mansão para recuperar os Ovos e o máximo de objetos de valor que conseguir."
t_Thief_N_Ob_1="NÃO seja visto. Ninguém pode saber que você esteve lá."
t_Thief_N_Sc_0="Evitar os guardas vale mais pontos do que deixá-los inconscientes, o que, por sua vez, vale mais do que matá-los."
t_Thief_N_Sc_1="Quanto mais saques opcionais você coletar, mais pontos você marca."
t_Thief_N_Sp_d="Esta mansão está cheia de segredos, procure em todos os lugares."
t_Thief_N_Go_d="O desafio acaba quando você for visto 3 vezes ou morrer."
t_Thief_E_Ob_2="Você não tem poderes sobrenaturais.<br>Algumas portas e baús agora estão trancados.<br>A localização de muitos itens valiosos foi alterada.<br>Os inimigos têm percepções mais aguçadas e causam mais dano."
t_Thief_E_Sp_0="Fique de olho nas 16 figurinhas escondidas."


