[Twk_Inv_CrossbowCorvo:DisTweaks_InventoryItem_PlayerSpecific_1 DisTweaks_InventoryItem_PlayerSpecific]
m_Name="Besta do Corvo "
m_Description="Uma arma silenciosa e exótica, feita dos melhores materiais. É usada para lançar setas tranquilizantes e incendiárias."

[Twk_Inv_PistolCorvo:DisTweaks_InventoryItem_PlayerSpecific_0 DisTweaks_InventoryItem_PlayerSpecific]
