m_StoreItems[25]=(m_Name="Chokedust Capacity",m_Description="Increases chokedust storage capacity by 4 (Total 9). ")
m_StoreItems[26]=(m_Name="Baffle Dust",m_Description="Changes chemical composition of chokedust so it induces short term confusion. Victims will resume normal, unsuspecting activity after exposure to the dust.")
m_StoreItems[27]=(m_Name="Arc Mine Capacity",m_Description="Increases arc mine storage capacity by 3 (Total 6).")
m_StoreItems[28]=(m_Name="Stun Mine Capacity",m_Description="Increases stun mine storage capacity by 3 (Total 6).")
m_StoreItems[29]=(m_Name="Arc Mine Extra Charge",m_Description="Adds an extra charge to the arc mine.")
m_StoreItems[30]=(m_Name="Stun Mine Extra Charge",m_Description="Adds an extra charge to the stun mine.")
m_StoreItems[31]=(m_Name="Stun Mine",m_Description="A modification to the arc mine design allows Daud to create a nonlethal version.")
m_StoreItems[32]=(m_Name="Bone Charm Capacity 1",m_Description="Enables one additional bone charm to be active (Total 4, Max 8).")
m_StoreItems[33]=(m_Name="Bone Charm Capacity 2",m_Description="Enables one additional bone charm to be active (Total 5, Max 8). ")
m_StoreItems[34]=(m_Name="Bone Charm Capacity 3",m_Description="Enables one additional bone charm to be active (Total 6, Max 8). ")
m_StoreItems[35]=(m_Name="Bone Charm Capacity 4",m_Description="Enables two additional bone charms to be active (Total 8, Max 8)")
m_StoreItems[36]=(m_Name="Overseer Daud",m_Description="You are disguised as an Overseer. An Overseer has been summoned to Coldridge Prison. Your contacts will intercept him and send you in his place. Using this overseer’s uniform as a disguise should fool the prison guards long enough to get you inside.")
m_StoreItems[37]=(m_Name="Misplaced Rune",m_Description="A recent sweep of the prison for contraband has yielded a number of heretical artifacts, one of them will accidently be misplaced for the right bribe.")
m_StoreItems[38]=(m_Name="Forged Requisition",m_Description="Forged requisition orders allow your contact to deliver stun mines to the prison. The key to the munitions lockers will be hidden nearby.")
m_StoreItems[39]=(m_Name="The Sunken Crate",m_Description="Allied Whalers will dump a crate loaded with supplies overboard near the Undine. You will have to dive to retrieve the contents.")
m_StoreItems[40]=(m_Name="The Hidden Rune",m_Description="A tunnel dweller has been bribed to bring a Rune from the depths of the Dunwall storm drains and place it within reach of the surface.")
m_StoreItems[41]=(m_Name="Former Rothwild Laborer",m_Description="A laborer you saved from the jail cell in Rothwild’s slaughterhouse has some useful information for you. Meet him at the Textile Mill.")
m_StoreItems[42]=(m_Name="A Gift From Abigail Ames",m_Description="Abigail Ames has contacted you through your network. She’s offering a bone charm that might be useful to you, in exchange for a small fee.")
m_StoreItems[43]=(m_Name="A Gift From Abigail Ames",m_Description="Abigail Ames has contacted you through your network. She wishes to put the past behind her and offers a gift for reconciliation.")
m_StoreItems[44]=(m_Name="Hole in the Fence",m_Description="Your operatives will drop you a rune, some mana and open the fence to allow for a more stealthy approach to the estate.")
m_StoreItems[45]=(m_Name="Thieving Butler",m_Description="The former butler smuggled goods from the estate and hid them by the shore.  One of your agents will unearth the cache for a price.")
m_StoreItems[46]=(m_Name="Turncoat",m_Description="Your agents have paid one of the witches to meet with you and provide information.  She’ll be wearing a red jacket.")

